# Web Service
WEB_PORT=8080

# Database Connection (used by Database.php)
DB_HOST=db
DB_PORT=3306
DB_NAME=mydatabase
DB_USER=myuser
DB_PASS=mypassword
DB_CHARSET=utf8mb4

# MariaDB / MySQL Service
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=mydatabase
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword

# phpMyAdmin Service
PMA_HOST=db
PMA_PORT=8081
