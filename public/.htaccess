# Ensure index.php loads automatically as the primary home page
DirectoryIndex index.php index.html

# Prevent users from browsing your folder structures if an index file is missing
Options -Indexes

# Enable URL rewriting (useful for clean URLs)
RewriteEngine On
# If a file or directory exists, load it
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# else send everything to index.php
RewriteRule ^(.*)$ index.php [QSA,L]