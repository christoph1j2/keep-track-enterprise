{% block stylesheets %}
<link rel="stylesheet" href="/assets/css/header.css" />
{% endblock %}

<!-- Header Partial for Homepage -->
<div class="container">
    <a href="/" class="navbar-brand" style="font-size: 1.1em">KeepTrack <sub style="color: blueviolet;">Enterprise</sub></a>

    <button class="navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer" aria-controls="navbarDrawer" aria-expanded="false" aria-label="Přepnout navigaci">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>
    <div class="vr mx-3"></div>
    <dialog class="drawer drawer-end" tabindex="-1" id="navbarDrawer" aria-labelledby="navbarDrawerLabel">
        <div class="drawer-header">
            <h5 class="drawer-title" id="navbarDrawerLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Zavřít"></button>
        </div>
        <div class="drawer-body">
            <ul class="navbar-nav me-auto">
                {% for link in nav_links %}
                    <li class="nav-item">
                        {% set is_active = (link.exact ?? false)
                            ? current_path == link.href
                            : current_path starts with link.href %}

                        <a class="nav-link {{ is_active ? 'active' : '' }}"
                           href="{{ link.href }}">{{ link.label }}</a>
                    </li>
                {% endfor %}
            </ul>
            {% if session.user_id != null %}
                <span class="text-info mx-md-auto text-center d-flex gap-3 align-items-center">
                    <a href="/profile">{{ session.username }}</a>
                    <form action="/dashboard" method="GET">
                        <input type="submit" value="Dashboard" />
                    </form>
                    <form action="/logout" method="POST">
                        <input type="submit" value="Odhlásit" />
                    </form>
                </span>

            {% else %}
                <div class="d-flex gap-1">
                    <a href="/register" class="btn btn-primary btn-sm">Registrovat</a>
                    <a href="/login" class="btn btn-outline-secondary btn-sm">Přihlásit se</a>
                </div>
            {% endif %}
        </div>
    </dialog>
</div>