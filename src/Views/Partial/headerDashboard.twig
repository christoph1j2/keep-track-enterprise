{% block stylesheets %}
    <link rel="stylesheet" href="/assets/css/dashboard.css" >
{% endblock %}
<!-- Header Partial for User Dashboard -->
<div class="container">
    <a href="/dashboard" class="navbar-brand" style="font-size: 1.1em">KeepTrack <sub style="color: blueviolet;">Enterprise</sub></a>

    <button class="navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarDrawer" aria-controls="navbarDrawer" aria-expanded="false" aria-label="Přepnout navigaci">
        <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>
    <div class="vr mx-3"></div>
    <dialog class="drawer drawer-end" tabindex="-1" id="navbarDrawer" aria-labelledby="navbarDrawerLabel">
        <div class="drawer-header">
            <h5 class="drawer-title" id="navbarDrawerLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Zavřít"></button>
        </div>
        <div class="drawer-body">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link
                       {{ current_path starts with '/dashboard' ? 'active' : '' }}"
                       href="/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link
                        {{ current_path starts with '/clients' ? 'active' : '' }}"
                       href="/clients">Klienti</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link
                       {{ current_path starts with '/invoices' ? 'active' : '' }}"
                       href="/invoices">Faktury</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link
                       {{ current_path starts with '/payments' ? 'active' : '' }}"
                       href="/payments">Platby</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link
                       {{ current_path starts with '/expenses' ? 'active' : '' }}"
                       href="/expenses">Výdaje</a>
                </li>
            </ul>
            <span class="text-info mx-md-auto text-center d-flex gap-3 align-items-center">
                <a>{{ session.username }}</a>
                <form action="/logout" method="POST">
                    <input type="submit" value="Odhlásit" />
                </form>
            </span>
        </div>
    </dialog>
</div>