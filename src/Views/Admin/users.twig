{% extends "layout.twig" %}

{% block title %}Správa uživatelů | KeepTrack Enterprise{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/assets/css/table.css">
{% endblock %}

{% block content %}

    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <h1>Správa uživatelů</h1>
        <span class="text-muted">Celkem uživatelů: <strong>{{ total }}</strong></span>
    </div>

    <div class="card p-3 md:p-5 my-4">
        {% if users|length == 0 %}
            <p class="m-auto fg-3"><em>V systému nejsou žádní uživatelé.</em></p>
        {% else %}
            <table class="table table-striped table-stack">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Uživatelské jméno</th>
                        <th>E-mail</th>
                        <th>Profese</th>
                        <th>Role</th>
                        <th>Stav</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                {% for u in users %}
                    {% set isSelf = (u.id == currentId) %}
                    {% set isTargetSuper = (u.role_name == 'superadmin') %}
                    {% set isTargetAdmin = (u.role_name == 'admin') %}
                    {% set canManage = not isSelf and not isTargetSuper and (isSuperAdmin or not isTargetAdmin) %}

                    <tr>
                        <td data-label="ID" class="align-middle">{{ u.id }}</td>
                        <td data-label="Uživatelské jméno" class="align-middle fw-bold">
                            {{ u.username }}
                            {% if isSelf %}
                                <span class="badge theme-info ms-1">Vy</span>
                            {% endif %}
                        </td>
                        <td data-label="E-mail" class="align-middle">{{ u.email }}</td>
                        <td data-label="Profese" class="align-middle">{{ u.profession|default('-') }}</td>
                        <td data-label="Role" class="align-middle">
                            {% if u.role_name == 'superadmin' %}
                                <span class="badge theme-danger">SuperAdmin</span>
                            {% elseif u.role_name == 'admin' %}
                                <span class="badge theme-warning">Admin</span>
                            {% elseif u.role_name == 'ucetni' %}
                                <span class="badge theme-info">Účetní</span>
                            {% elseif u.role_name == 'osvc' %}
                                <span class="badge theme-primary">OSVČ</span>
                            {% else %}
                                <span class="badge theme-secondary">-</span>
                            {% endif %}
                        </td>
                        <td data-label="Stav" class="align-middle">
                            {% if u.is_blocked %}
                                <span class="badge theme-danger">Blokován</span>
                            {% else %}
                                <span class="badge theme-success">Aktivní</span>
                            {% endif %}
                        </td>
                        <td class="text-end align-middle">
                            {% if not canManage %}
                                <span class="text-muted small fst-italic">
                                    {% if isSelf %}
                                        Váš účet
                                    {% elseif isTargetSuper %}
                                        Chráněno (SuperAdmin)
                                    {% else %}
                                        Chráněno (Admin)
                                    {% endif %}
                                </span>
                            {% else %}
                                <div class="d-inline-flex flex-wrap gap-2 justify-content-end align-items-center">
                                    <form method="post" action="/admin/users/change-role" class="d-inline-flex gap-1 align-items-center">
                                        {{ csrf_field|raw }}
                                        <input type="hidden" name="id" value="{{ u.id }}">
                                        <select name="role" class="form-control form-control-sm" aria-label="Role uživatele {{ u.username }}">
                                            {% for r in roles %}
                                                {% if r.role != 'superadmin' and (isSuperAdmin or r.role != 'admin') %}
                                                    <option value="{{ r.role }}" {{ u.role_name == r.role ? 'selected' : '' }}>
                                                        {{ r.role }}
                                                    </option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <button type="submit"
                                                class="btn btn-sm btn-outline theme-primary"
                                                title="Změnit roli">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                    <form method="post" action="/admin/users/toggle-block" class="d-inline">
                                        {{ csrf_field|raw }}
                                        <input type="hidden" name="id" value="{{ u.id }}">
                                        {% if u.is_blocked %}
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline theme-success"
                                                    title="Odblokovat uživatele">
                                                <i class="bi bi-unlock-fill"></i>
                                            </button>
                                        {% else %}
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline theme-warning"
                                                    title="Zablokovat uživatele">
                                                <i class="bi bi-lock-fill"></i>
                                            </button>
                                        {% endif %}
                                    </form>

                                    <form method="post"
                                          action="/admin/users/delete"
                                          class="d-inline delete-user-form"
                                          data-username="{{ u.username }}">
                                        {{ csrf_field|raw }}
                                        <input type="hidden" name="id" value="{{ u.id }}">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline theme-danger"
                                                title="Smazat uživatele">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% include "Partial/pagination.twig" %}
        {% endif %}
    </div>

    <script>
        document.querySelectorAll('.delete-user-form').forEach(form => {
            form.addEventListener('submit', function(event) {
                const username = this.dataset.username || '';
                if (!confirm(`Opravdu chcete trvale smazat uživatele "${username}"? Tato akce je nevratná.`)) {
                    event.preventDefault();
                }
            });
        });
    </script>

{% endblock %}
