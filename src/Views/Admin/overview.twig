{% extends "layout.twig" %}

{% block title %}Administrace | KeepTrack Enterprise{% endblock %}

{% block content %}

    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-4">
        <h1>Administrace systému</h1>
    </div>

    {% set cards = [
        {label: "Uživatelé celkem",   value: stats.users_total},
        {label: "OSVČ",               value: stats.osvc},
        {label: "Účetní",             value: stats.ucetni},
        {label: "Administrátoři",     value: stats.admins},
        {label: "Blokovaní uživatelé", value: stats.users_blocked},
        {label: "Klienti celkem",     value: stats.clients},
        {label: "Faktury celkem",     value: stats.invoices},
        {label: "Platby celkem",      value: stats.payments},
        {label: "Výdaje celkem",      value: stats.expenses}
    ] %}

    <div class="row g-3 mb-4">
        {% for c in cards %}
            <div class="col-12 md:col-6 lg:col-4">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-muted fs-6 text-uppercase">{{ c.label }}</h5>
                        <h2 class="display-6 fw-bold">{{ c.value }}</h2>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3">
        <div class="col-12 md:col-6">
            <div class="card h-100 p-3">
                <div class="card-body d-flex flex-column justify-content-between gap-3">
                    <div>
                        <h4 class="card-title">Správa uživatelů</h4>
                        <p class="text-muted mb-0">
                            Přehled registrovaných účtů, změna rolí, blokace přístupu a mazání uživatelů.
                        </p>
                    </div>
                    <div>
                        <a href="/admin/users" class="btn-solid theme-primary">Přejít na uživatele</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 md:col-6">
            <div class="card h-100 p-3">
                <div class="card-body d-flex flex-column justify-content-between gap-3">
                    <div>
                        <h4 class="card-title">Číselník typů klientů</h4>
                        <p class="text-muted mb-0">
                            Správa kategorií klientů (<code>client_types</code>) dostupných OSVČ při evidenci klientů.
                        </p>
                    </div>
                    <div>
                        <a href="/admin/client-types" class="btn-solid theme-secondary">Spravovat typy klientů</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
