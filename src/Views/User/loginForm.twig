{% extends "layout.twig" %}

{% block title %}Přihlášení | KeepTrack Enterprise{% endblock %}

{% block content %}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h3 class="card-title mb-1">Přihlášení</h3>

                <form method="POST" action="/login" novalidate>

                    {# Email #}
                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control {{ errors.email ? 'is-invalid' : '' }}"
                            value="{{ data.email }}"
                            required
                        />
                        {% if errors.email %}
                            <div class="invalid-feedback">{{ errors.email }}</div>
                        {% endif %}
                    </div>

                    {# Password #}
                    <div class="mb-4">
                        <label for="password" class="form-label">Heslo</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control {{ errors.password ? 'is-invalid' : '' }}"
                            autocomplete="current-password"
                            required
                        />
                        {% if errors.password %}
                            <div class="invalid-feedback">{{ errors.password }}</div>
                        {% endif %}
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Přihlásit se</button>

                </form>

            </div>
        </div>

        <p class="text-center text-muted small mt-3">
            Nemáte účet? <a href="/register">Registrovat se</a>
        </p>

    </div>
</div>

{% endblock %}