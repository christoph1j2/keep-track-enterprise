{% extends "layout.twig" %}

{% block title %}Registrace | KeepTrack Enterprise{% endblock %}

{% block content %}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h3 class="card-title mb-1">Registrace</h3>

                <form method="POST" action="/register">

                    {# Username #}
                    <div class="mb-3">
                        <label for="username" class="form-label">Uživatelské Jméno</label>
                        <input
                            type="text"
                            name="username"
                            value="{{ data.username }}"
                            class="form-control {{ (errors.username) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.username) %}
                            <div class="invalid-feedback">{{ errors.username }}</div>
                        {% endif %}

                        <label for="email" class="form-label">E-mail</label>
                        <input
                            type="email"
                            name="email"
                            value="{{ data.email }}"
                            class="form-control {{ (errors.email) ? 'is_invalid' : '' }}"
                        />
                        {% if (errors.email) %}
                            <div class="invalid-feedback">{{ errors.email }}</div>
                        {% endif %}

                        <label for="password" class="form-label">Heslo</label>
                        <input
                            type="password"
                            name="password"
                            class="form-control {{ (errors.password) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.password) %}
                            <div class="invalid-feedback">{{ errors.password }}</div>
                        {% endif %}

                        <label for="password_confirm" class="form-label">Potvrdit heslo</label>
                        <input
                            type="password"
                            name="password_confirm"
                            class="form-control {{ (errors.password) ? 'is-invalid' : '' }}"/>
                        {% if (errors.password_confirm) %}
                            <div class="invalid-feedback">{{ errors.password_confirm }}</div>
                        {% endif %}

                        <input type="submit" value="Registrovat se"/>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

{% endblock %}