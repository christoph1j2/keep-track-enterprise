{% extends "layout.twig" %}

{% block title %}Registrace | KeepTrack Enterprise{% endblock %}

{% block content %}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h1 class="card-title h3 mb-1">Registrace {% if (mode === 'accountant') %}jako účetní{% endif %}</h1>

                <form method="POST" action="/register">
                    {{ csrf_field|raw }}

                    {# Username #}
                    <div class="mb-3">
                        <label for="username" class="form-label">Uživatelské Jméno</label>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            value="{{ data.username }}"
                            class="form-control {{ (errors.username) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.username) %}
                            <div class="invalid-feedback">{{ errors.username }}</div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="{{ data.email }}"
                            class="form-control {{ (errors.email) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.email) %}
                            <div class="invalid-feedback">{{ errors.email }}</div>
                        {% endif %}
                    </div>

                    {% if (mode !== 'accountant') %}
                    <div class="mb-3">
                        <label for="profession" class="form-label">Profese <span class="text-muted small">(volitelné)</span></label>
                        <input
                            type="text"
                            id="profession"
                            name="profession"
                            maxlength="255"
                            value="{{ data.profession ?? '' }}"
                            placeholder="Např. Vývoj webových aplikací"
                            class="form-control {{ (errors.profession) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.profession) %}
                            <div class="invalid-feedback">{{ errors.profession }}</div>
                        {% endif %}
                    </div>
                    {% endif %}

                    <div class="mb-3">
                        <label for="password" class="form-label">Heslo</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control {{ (errors.password) ? 'is-invalid' : '' }}"
                        />
                        {% if (errors.password) %}
                            <div class="invalid-feedback">{{ errors.password }}</div>
                        {% endif %}
                    </div>

                    <div class="mb-4">
                        <label for="password_confirm" class="form-label">Potvrdit heslo</label>
                        <input
                            type="password"
                            id="password_confirm"
                            name="password_confirm"
                            class="form-control {{ (errors.password_confirm) ? 'is-invalid' : '' }}"/>
                        {% if (errors.password_confirm) %}
                            <div class="invalid-feedback">{{ errors.password_confirm }}</div>
                        {% endif %}
                    </div>

                    {% if (mode === 'accountant') %}
                    <div class="mb-4">
                        <label for="accountant_key" class="form-label">Unikátní klíč</label>
                        <input
                            type="text"
                            id="accountant_key"
                            name="accountant_key"
                            value="{{ data.accountant_key ?? '' }}"
                            class="form-control {{ (errors.accountant_key) ? 'is-invalid' : '' }}"/>
                            {% if (errors.accountant_key) %}
                                <div class="invalid-feedback">{{ errors.accountant_key }}</div>
                            {% endif %}
                    </div>
                    {% endif %}
                    <input type="hidden" name="mode" value="{{ mode }}" />

                    <button type="submit" class="btn-solid theme-primary w-100">Registrovat se</button>
                </form>

            </div>
        </div>

        {% if (mode !== 'accountant') %}
        <p class="text-end">
            <a href="/register?mode=accountant">Registrovat jako účetní?</a>
        </p>
        {% endif %}

    </div>
</div>

{% endblock %}