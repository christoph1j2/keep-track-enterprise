<script>
    // connect event listener for the table
    if (table) {
        table.addEventListener('click', function(event) {
            const deleteBtn = event.target.closest('.delete-btn');

            // if deleteBtn was clicked
            if (deleteBtn) {
                // we get clientid
                const clientId = deleteBtn.dataset.id;
                // we get row
                const row = deleteBtn.closest('tr');

                // confirm
                if (confirm(`Opravdu chcete smazat tohoto klienta (ID: ${clientId})?`)) {

                    fetch('/clients/delete', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({ id: clientId }),
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.status === 'success')
                            {
                                row.remove();
                                if (!table.querySelector('tbody tr')) window.location.reload();
                            }
                            else
                                alert('Chyba: ' + data.message);
                        })
                        .catch(error => {
                            console.error('Chyba komunikace se serverem:',error);
                        })

                }
            }
        });
    }
</script>