<!-- dialog for client edit -->
<dialog class="dialog" id="editClientDialog">
    <form id="editClientForm" data-bs-validate>
        <div class="dialog-header">
            <h5 class="dialog-title">Upravit klienta</h5>
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Zavřít"></button>
        </div>
        <div class="dialog-body">
            <input type="hidden" name="id" id="editClientId" />

            <label class="form-label" for="editName">Jméno Klienta<span class="fg-danger">*</span></label>
            <input type="text" id="editName" name="name" class="form-control" required>

            <label class="form-label mt-1" for="editContactEmail">Kontaktní E-mail</label>
            <input type="email" id="editContactEmail" name="contact_email" class="form-control">

            <label class="form-label mt-1" for="editContactPhone">Telefonní Číslo</label>
            <input type="tel" id="editContactPhone" name="contact_phone" class="form-control">

            <label class="form-label mt-1" for="editIco">IČO <sub class="fg-secondary"><em>8 znaků</em></sub></label>
            <input type="text" inputmode="numeric" pattern="\d{8}" id="editIco" name="ico" class="form-control">

            <label class="form-label mt-1" for="editDic">DIČ</label>
            <input type="text" id="editDic" name="dic" class="form-control">

            <label class="form-label mt-1" for="editDescription">Popisek</label>
            <input type="text" id="editDescription" name="description" class="form-control">

            <label class="form-label mt-1" for="editClientType">Typ Klienta</label>
            <select id="editClientType" name="client_type" class="form-control">
                <option value="">- Vyberte -</option>
                {% for type in clientTypes %}
                    <option value="{{ type.id }}">{{ type.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="dialog-footer">
            <button type="submit" class="btn-solid theme-secondary">Uložit změny</button>
        </div>
    </form>
</dialog>

<script>
    /** @type {HTMLDialogElement} */
    const editDialog = document.getElementById('editClientDialog');
    const editForm = document.getElementById('editClientForm');

    // click event listener
    if (table) {
        table.addEventListener('click', function(event) {
            const editBtn = event.target.closest('.edit-btn');
            if (!editBtn) return;

            const clientId = editBtn.dataset.id;

            // fill remaining fields
            fetch('/clients/get', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: new URLSearchParams({ id:clientId})
            })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    const client = data.client;
                    console.log(client);
                    document.getElementById('editClientId').value = client.id;
                    document.getElementById('editName').value = client.name || '';
                    document.getElementById('editContactEmail').value = client.contact_email || '';
                    document.getElementById('editContactPhone').value = client.contact_phone || '';
                    document.getElementById('editIco').value = client.ico || '';
                    document.getElementById('editDic').value = client.dic || '';
                    document.getElementById('editDescription').value = client.description || '';
                    document.getElementById('editClientType').value = client.type_id || '';

                    editDialog.showModal();
                }
                else {
                    alert('Nastala chyba.'+data.message);
                }
            })
            .catch(error => {
                console.error(error);
            })

        });
    }

    // submit event listener
    editForm.addEventListener('submit', function(event) {
        event.preventDefault();

        const formData = new FormData(this);

        fetch('/clients/edit', {
            method: 'POST',
            body: formData,
        })
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success') {
                    updateDom(formData);
                }
                else{
                    alert('Nastala chyba: '+data.message);
                }
            })
            .catch(error => console.log(error));
    })


    /**
     * Updates the DOM with new data.
     * @param formData
     */
    function updateDom(formData)
    {
        const row = table.querySelector(`tr[data-id='${formData.get('id')}']`);

        const typeSel = document.getElementById('editClientType'); // ?
        const typeName = typeSel.value ? typeSel.selectedOptions[0].textContent : '-';

        const values = {
            name:          formData.get('name'),
            contact_email: formData.get('contact_email'),
            contact_phone: formData.get('contact_phone'),
            ico:           formData.get('ico'),
            dic:           formData.get('dic'),
            description:   formData.get('description'),
            type_name:     typeName,
        };

        for (const [field, value] of Object.entries(values)) {
            const cell = row.querySelector(`[data-field="${field}"]`);
            if (cell) cell.textContent = value;
        }

        editDialog.close();
    }
</script>