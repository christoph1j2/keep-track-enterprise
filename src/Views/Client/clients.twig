{% extends "layout.twig" %}

{% block title %}Evidence Klientů | KeepTrack Enterprise{% endblock %}

{% block content %}

    <div class="d-flex justify-content-between">
        <h1>Evidence Klientů</h1>
        <button class="btn-solid theme-secondary" data-bs-toggle="dialog" data-bs-target="#addClientDialog">
            Přidat nového klienta
        </button>
    </div>

    <div class="card h-100 p-10 my-5">
        {% if clients|length == 0 %}
            <p class="m-auto fg-3"><em>Neevidujete žádné klienty.</em></p>
        {% else %}
            <table class="table">
                <tbody>
                    <tr>
                        <th>Jméno</th>
                        <th>E-Mail</th>
                        <th>Telefon</th>
                        <th>IČO</th>
                        <th>DIČ</th>
                        <th>Popis</th>
                        <th>Typ</th>
                    </tr>
                {% for client in clients %}
                    <tr>
                        <td>{{ client.name }}</td>
                        <td>{{ client.contact_email }}</td>
                        <td>{{ client.contact_phone }}</td>
                        <td>{{ client.ico }}</td>
                        <td>{{ client.dic }}</td>
                        <td>{{ client.description }}</td>
                        <td>{{ client.type_name|default('-') }}</td>
                    </tr>
                {% endfor %}
                <!-- TODO: add delete and edit cells(+form) -->
                </tbody>
            </table>
        {% endif %}
    </div>

    {% include "Client/addClient.twig" %}

{% endblock %}