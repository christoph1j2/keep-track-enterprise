{% extends "layout.twig" %}

{% block title %}Dashboard | KeepTrack Enterprise{% endblock %}

{% block content %}

    <div class="row mb-4">
        <div class="col-12">
            <h1>Dashboard</h1>
        </div>
    </div>


    {% if role == "osvc" %}
        {#  kpi cards  #}
        {% include "Dashboard/OSVC/kpi.twig" %}
        {% if unpaidInvoices|length > 0 %}
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Unpaid invoices</span>
                    <span class="badge theme-danger">{{ unpaidInvoices|length }}</span>
                </div>

                <div class="table-responsive" style="max-height: 250px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                        <tr>
                            <th class="sticky-top">Invoice #</th>
                            <th class="sticky-top">Due date</th>
                            <th class="sticky-top text-end">Total</th>
                            <th class="sticky-top text-end">Remaining</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for i in unpaidInvoices %}
                            {% set overdue = i.date_due is not null and i.date_due < 'today'|date('Y-m-d') %}
                            <tr class="{{ overdue ? 'theme-danger' : '' }}">
                                <td>{{ i.invoice_number }}</td>
                                <td>{{ i.date_due ? i.date_due|date('d.m.Y') : '-' }}</td>
                                <td class="text-end">{{ i.total_amount|number_format(2, ',', ' ') }} Kč</td>
                                <td class="text-end fw-semibold">{{ i.remaining_amount|number_format(2, ',', ' ') }} Kč</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <hr/>
        {% endif %}
        {# action cards #}
        {% include "Dashboard/OSVC/action.twig" %}
    {# todo: rework for accountant #}
    {% elseif role == "ucetni" %}
        <p>cigi</p>
    {% endif %}
{% endblock %}