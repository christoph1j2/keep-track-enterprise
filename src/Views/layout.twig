<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}KeepTrack Enterprise{% endblock %}</title>
    <!-- Boostrap 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>
<body>

    <nav class="navbar md:navbar-expand border-bottom mb-4" data-bs-theme="dark">
        {% if session.user_id %}
            {% if session.role == 'admin' %}
                <!-- TODO: include admin header -->
            {% else %}
                {% include "Partial/headerDashboard.twig" %}
            {% endif %}
        {% else %}
            {% include "Partial/headerHome.twig" %}
        {% endif %}
    </nav>

    <main class="container">
        {% block content %}
        {% endblock %}
    </main>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>