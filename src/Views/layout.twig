<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}KeepTrack Enterprise{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    <!-- Boostrap 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
</head>
<body>

    <nav class="navbar md:navbar-expand border-bottom mb-4" data-bs-theme="dark">
        {% if session.user_id %}
            {% if session.role == 'admin' %}
                <!-- TODO: include admin header -->
            {% else %}
                {% include "Partial/headerDashboard.twig" %}
            {% endif %}
        {% else %}
            {% include "Partial/headerHome.twig" %}
        {% endif %}
    </nav>

    <main class="container">
        {% block content %}
        {% endblock %}
    </main>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global Interceptor for AJAX fetch
        (function()
        {
            // store native fetch reference
            const originalFetch = window.fetch;

            // override global fetch
            window.fetch = async function(...args)
            {
                let [resource, config] = args;
                config = config || {};

                // ensure headers object exists
                if (!config.headers)
                {
                    config.headers = {};
                }

                // attach AJAX identification header for backend (BaseController::isAjax)
                if (config.headers instanceof Headers)
                {
                    config.headers.append('X-Requested-With', 'XMLHttpRequest');
                }
                else
                {
                    config.headers['X-Requested-With'] = 'XMLHttpRequest';
                }

                // execute actual request
                const res = await originalFetch(resource, config);

                // session expired - redirect unauthorized user back to login
                if (res.status === 401)
                {
                    window.location.href = '/login';
                    return Promise.reject(new Error('Relace vypršela - přesměrování na přihlášení.'));
                }

                return res;
            };
        })();
    </script>
</body>
</html>
