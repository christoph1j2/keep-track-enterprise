<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <title>{% block title %}KeepTrack Enterprise{% endblock %}</title>
    <link rel="stylesheet" href="/assets/css/header.css" />
    {% block stylesheets %}{% endblock %}
    <!-- Boostrap 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
</head>
<body>

    <nav class="navbar md:navbar-expand border-bottom mb-4" data-bs-theme="dark">
        {% if session.role in ['admin', 'superadmin'] %}
            {% set nav_links = [
                { label: 'Přehled',      href: '/admin/overview' },
                { label: 'Uživatelé',    href: '/admin/users' },
                { label: 'Typy klientů', href: '/admin/client-types' }
            ] %}
        {% elseif session.role == 'ucetni' %}
            {% set nav_links = [
                { label: 'Dashboard',   href: '/dashboard'           },
                { label: 'Klienti',     href: '/accountant/clients'  },
                { label: 'Faktury',     href: '/accountant/invoices' },
                { label: 'Platby',      href: '/accountant/payments' },
                { label: 'Výdaje',      href: '/accountant/expenses' }
            ] %}
        {% elseif session.user_id %}
            {% set nav_links = [
                { label: 'Dashboard',  href: '/dashboard' },
                { label: 'Klienti',    href: '/clients'   },
                { label: 'Faktury',    href: '/invoices'  },
                { label: 'Platby',     href: '/payments'  },
                { label: 'Výdaje',     href: '/expenses'  }
            ] %}
        {% else %}
            {% set nav_links = [
                { label: 'Úvod',    href: '/', exact: true },
                { label: 'O aplikaci', href: '/about'  },
                { label: 'Funkce',  href: '/features'  }
            ] %}
        {% endif %}
        {% include "Partial/header.twig" with { nav_links: nav_links } %}
    </nav>

    <main class="container">
        <div id="flashContainer" class="mb-2">
            {% if flash %}
                <div class="alert theme-{{ flash.type ?? 'info' }}" role="alert">
                    <span>{{ flash.message }}</span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Zavřít"></button>
                </div>
            {% endif %}
        </div>
        {% block content %}
        {% endblock %}
    </main>

    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global flash alert helper (works both on page and inside open <dialog> modals)
        window.showFlash = function(type, message) {
            const openDialog = document.querySelector('dialog[open] .dialog-body');
            const container = openDialog || document.getElementById('flashContainer');
            if (!container) return;

            if (openDialog) {
                openDialog.querySelectorAll('.js-flash-alert').forEach(el => el.remove());
            } else {
                container.innerHTML = '';
            }

            const alertDiv = document.createElement('div');
            alertDiv.className = `alert theme-${type} mb-3 js-flash-alert`;
            alertDiv.setAttribute('role', 'alert');

            const msgSpan = document.createElement('span');
            msgSpan.textContent = message;

            const closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'btn-close ms-auto';
            closeBtn.setAttribute('data-bs-dismiss', 'alert');
            closeBtn.setAttribute('aria-label', 'Zavřít');

            alertDiv.append(msgSpan, closeBtn);
            container.prepend(alertDiv);
        };

        // Global Interceptor for AJAX fetch
        (function()
        {
            // store native fetch reference
            const originalFetch = window.fetch;
            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

            // override global fetch
            window.fetch = async function(...args)
            {
                let [resource, config] = args;
                config = config || {};

                // ensure headers object exists
                if (!config.headers)
                {
                    config.headers = {};
                }

                const method = (config.method || 'GET').toUpperCase();

                // attach AJAX + CSRF headers for backend
                if (config.headers instanceof Headers)
                {
                    config.headers.append('X-Requested-With', 'XMLHttpRequest');
                    if (method === 'POST' && csrfToken && !config.headers.has('X-CSRF-Token'))
                    {
                        config.headers.append('X-CSRF-Token', csrfToken);
                    }
                }
                else
                {
                    config.headers['X-Requested-With'] = 'XMLHttpRequest';
                    if (method === 'POST' && csrfToken && !config.headers['X-CSRF-Token'])
                    {
                        config.headers['X-CSRF-Token'] = csrfToken;
                    }
                }

                // execute actual request
                const res = await originalFetch(resource, config);

                // session expired - redirect unauthorized user back to login
                if (res.status === 401)
                {
                    window.location.href = '/login';
                    return Promise.reject(new Error('Relace vypršela - přesměrování na přihlášení.'));
                }

                return res;
            };
        })();
    </script>
</body>
</html>
