<!-- dialog for expense edit -->
<dialog class="dialog" id="editExpenseDialog">
    <form id="editExpenseForm" data-bs-validate enctype="multipart/form-data">
        <div class="dialog-header">
            <h5 class="dialog-title">Upravit výdaj</h5>
            <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Zavřít"></button>
        </div>
        <div class="dialog-body">
            <input type="hidden" name="id" id="editExpenseId" />

            <label for="editExpenseName" class="form-label">
                Název<span class="fg-danger">*</span>
            </label>
            <input type="text" name="name" id="editExpenseName" class="form-control" required />

            <label for="editExpenseAmount" class="form-label mt-2">
                Částka<span class="fg-danger">*</span>
            </label>
            <input type="number" name="total_amount" id="editExpenseAmount" class="form-control" required />

            <label for="editExpenseDate" class="form-label mt-2">
                Datum výdaje<span class="fg-danger">*</span>
            </label>
            <input type="date" name="expense_date" id="editExpenseDate" class="form-control" required />

            <label class="form-label mt-2" for="editExpenseNote">Poznámka</label>
            <input type="text" id="editExpenseNote" name="note" class="form-control">

            {# current receipt, hidden if none available #}
            <div id="editReceiptCurrent" class="mt-3" hidden>
                <span class="form-label">Aktuální účtenka:</span>
                <a id="editReceiptLink" href="#" target="_blank" rel="noopener"></a>
                <div class="form-check mt-1">
                    <input type="checkbox" class="form-check-input" id="editRemoveReceipt" name="remove_receipt" value="1">
                    <label class="form-check-label" for="editRemoveReceipt">Odstranit účtenku</label>
                </div>
            </div>

            <label for="editExpenseFile" class="form-label mt-2">
                <span id="editFileLabel">Účtenka (.pdf/.jpg/.png)</span>
            </label>
            <input type="file" id="editExpenseFile" name="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
        </div>
        <div class="dialog-footer">
            <button type="submit" class="btn-solid theme-secondary">Uložit změny</button>
        </div>
    </form>
</dialog>

<script>
    /** @type {HTMLDialogElement} */
    const editExpenseDialog = document.getElementById('editExpenseDialog');
    const editExpenseForm = document.getElementById('editExpenseForm');
    const remove = document.getElementById('editRemoveReceipt');
    const fileInput = document.getElementById('editExpenseFile');

    // open+fill
    if (table)
    {
        table.addEventListener('click', async function (event) {
            const btn = event.target.closest('.edit-btn');
            if (!btn) return;

            const id = btn.dataset.id;
            try
            {
                const res = await fetch('/expenses/get', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: new URLSearchParams({id}),
                });
                const data = await res.json();
                if (!res.ok || data.status !== 'success') {
                    alert('Nastala chyba: ' + (data.message ?? ''));
                    return;
                }
                const e = data.expense;
                editExpenseForm.reset();
                document.getElementById('editExpenseId').value     = e.id;
                document.getElementById('editExpenseName').value   = e.name || '';
                document.getElementById('editExpenseAmount').value = e.total_amount ?? '';
                document.getElementById('editExpenseDate').value   = (e.expense_date || '').slice(0, 10); // datetime -> yyyy-mm-dd
                document.getElementById('editExpenseNote').value   = e.note || '';

                const hasReceipt = e.receipt_original_name;

                const current = document.getElementById('editReceiptCurrent');
                const link    = document.getElementById('editReceiptLink');
                current.hidden = !hasReceipt;
                if (hasReceipt) {
                    link.textContent = e.receipt_original_name;
                    link.href = `/expenses/receipt?id=${e.id}`;
                }
                document.getElementById('editFileLabel').textContent =
                    hasReceipt ? 'Nahradit účtenku novým souborem (Max 5MB)' : 'Účtenka (.pdf/.jpg/.png) Max 5MB';

                editExpenseDialog.showModal();
            } catch (err) {
                console.error(err);
            }
        })
    }

    // picking new file makes remove pointless and vice versa
    fileInput.addEventListener('change', () => { if (fileInput.files.length) remove.checked = false; });
    remove.addEventListener('change', () => { if (remove.checked) fileInput.value = ''; });

    // submit
    editExpenseForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const btn = this.querySelector('button[type="submit"]');
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Nahrávám';

        try {
            const res  = await fetch('/expenses/edit', {
                method: 'POST',
                body: new FormData(this),          // don't set Content-Type!
                headers: {'Accept': 'application/json'},
            });
            const data = await res.json();
            if (!res.ok || data.status !== 'success') {
                alert('Nastala chyba: ' + (data.message ?? ''));
                return;
            }
            window.location.reload();
        } catch (err) {
            console.error(err);
            alert('Nepodařilo se spojit se serverem.');
        } finally {
            btn.disabled = false;
            btn.textContent = originalText;
        }
    });
</script>