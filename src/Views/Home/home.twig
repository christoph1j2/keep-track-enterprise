{% extends "layout.twig" %}

{% block title %}Úvodní stránka | KeepTrack Enterprise{% endblock %}

{% block content %}

    <div class="row">
        <div class="d-flex flex-column justify-content-center align-items-center text-center" style="height: 80vh">
            <h1>KeepTrack Enterprise</h1>
            <p class="lead">Mějte své faktury, klienty a výdaje pod kontrolou.</p>

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                {% if session.user_id != null %}
                    <a href="{{ session.role in ['admin', 'superadmin'] ? '/admin/overview' : '/dashboard' }}"
                       class="btn-solid theme-primary btn-lg">
                        {{ session.role in ['admin', 'superadmin'] ? 'Přejít do administrace' : 'Přejít na Dashboard' }}
                    </a>
                {% else %}
                    <a href="/register" class="btn-solid theme-primary btn-lg">Registrovat</a>
                    <a href="/login" class="btn-outline theme-secondary btn-lg">Přihlásit se</a>
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}